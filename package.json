{
  "name": "ui-test-automation-playwright",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test automation framework for web (desktop & mobile viewports) with an API layer for test data preparation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:desktop": "playwright test --project=chromium-desktop --project=firefox-desktop --project=webkit-desktop",
    "test:mobile": "playwright test --project=mobile-chrome-pixel7 --project=mobile-safari-iphone14 --project=mobile-small-320 --project=tablet-ipad",
    "test:chromium": "playwright test --project=chromium-desktop",
    "test:firefox": "playwright test --project=firefox-desktop",
    "test:webkit": "playwright test --project=webkit-desktop",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:dev": "TEST_ENV=dev playwright test",
    "test:staging": "TEST_ENV=staging playwright test",
    "test:prod": "TEST_ENV=prod playwright test",
    "test:serial": "playwright test --workers=1",
    "codegen": "playwright codegen",
    "report": "playwright show-report reports/html",
    "trace": "playwright show-trace",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:browsers": "playwright install --with-deps",
    "clean": "rm -rf reports test-results .auth"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "test-automation",
    "mobile",
    "api-testing"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "zod": "^4.6.5"
  }
}
