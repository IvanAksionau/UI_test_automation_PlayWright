# Copy to `.env` and adjust. `.env` is git-ignored.

# Which environment file to load from config/environments/<TEST_ENV>.json
TEST_ENV=staging

# Optional overrides of the values inside the environment file
# BASE_URL=https://practicesoftwaretesting.com
# API_BASE_URL=https://api.practicesoftwaretesting.com
# RETRIES=1

# Optional pre-existing account (tests create their own users via API when not provided)
# ADMIN_EMAIL=admin@practicesoftwaretesting.com
# ADMIN_PASSWORD=welcome01

# Runtime switches
HEADLESS=true
# WORKERS=4          # number or percentage, e.g. 50%
LOG_LEVEL=info       # debug | info | warn | error
# CI=true
